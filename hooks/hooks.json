{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/skill_picker.py"], "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/rule_enforcer.py"], "timeout": 20 }
        ]
      }
    ]
  }
}
